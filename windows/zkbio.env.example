# Gateway runtime config for a NATIVE Windows install (no Docker).
#
# `.\make.ps1 native-build` copies this to dist\windows\.env — edit that copy,
# not this template. The service changes its working directory to the folder
# holding zkbio.exe on start, so this file must sit next to the executable and
# LOG_DIR may stay relative.

APP_ENV=production
PORT=8080
LOG_DIR=logs

# Timezone the gateway interprets naive device timestamps in.
# MUST be an IANA zone name ("Africa/Dar_es_Salaam"), never a Windows one
# ("E. Africa Standard Time"). The binary embeds the IANA database, so this
# works on Windows with no tzdata installed.
TZ=Africa/Dar_es_Salaam

# ── Local database (the durable punch queue) ────────────────────────────────
# A native install brings its own MariaDB. Install MariaDB for Windows, then:
#   CREATE DATABASE erp_zkbio CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'erp_zkbio'@'localhost' IDENTIFIED BY '<password>';
#   GRANT ALL PRIVILEGES ON erp_zkbio.* TO 'erp_zkbio'@'localhost';
# The gateway creates and migrates its own tables on startup.
#
# 127.0.0.1 rather than "localhost": on Windows "localhost" can resolve to ::1
# first, and MariaDB is often bound to IPv4 only.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DBNAME=erp_zkbio
MYSQL_USER=erp_zkbio
MYSQL_PASS=CHANGEME_zkbio_db_password

# ── ERP HR ingest endpoint ──────────────────────────────────────────────────
HR_INGEST_URL=https://your-erp-domain.com/hrm/device/attendance/logs
HR_TIMEOUT_SECONDS=30
# Allow a self-signed HR TLS cert (LAN/testing only — leave false in production).
HR_INSECURE_TLS=false

# ── Credential encryption at rest ───────────────────────────────────────────
# Encrypts each device's HR X-Device-Key in the database (AES-256-GCM).
# Generate one in PowerShell with:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
CRED_ENC_KEY=CHANGEME_generate_a_32_byte_random_key

# ── Management API auth ─────────────────────────────────────────────────────
# Shared token for the operator/management API (sent as X-API-Key or
# Authorization: Bearer). If empty, the API is OPEN on the LAN — set it.
#   -join ((1..24 | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) }))
MGMT_API_KEY=CHANGEME_management_api_token

# ── Forwarder (delivery) tuning ─────────────────────────────────────────────
FORWARD_INTERVAL_SECONDS=15
FORWARD_BATCH=200
# 0 = retry undelivered punches forever (recommended: never drop attendance).
FORWARD_MAX_ATTEMPTS=0

# ── Pull collector (poll devices over TCP 4370) ─────────────────────────────
PULL_ENABLED=true
PULL_INTERVAL_SECONDS=30
PULL_CONN_TIMEOUT_SECONDS=10

# ── Push (ADMS/iclock) endpoints ────────────────────────────────────────────
PUSH_ENABLED=true
PUSH_AUTO_REGISTER_SN=true

# ── Retention ───────────────────────────────────────────────────────────────
# Purge DELIVERED punches older than this (Pending/Failed are never purged).
# 0 = keep forever. 90 days:
PUNCH_RETENTION_SECONDS=7776000
