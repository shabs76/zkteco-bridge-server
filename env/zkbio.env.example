# Gateway runtime config. Copy to zkbio.env and fill in. Never commit zkbio.env.

APP_ENV=production
PORT=8080
LOG_DIR=/app/logs
TZ=Africa/Dar_es_Salaam

# ── Local database (the durable punch queue) ────────────────────────────────
# Host is the compose service name. Password must match ERP_ZKBIO_DB_PASSWORD in
# env/db.env.
MYSQL_HOST=mariadb
MYSQL_PORT=3306
MYSQL_DBNAME=erp_zkbio
MYSQL_USER=erp_zkbio
MYSQL_PASS=CHANGEME_zkbio_db_password

# ── ERP HR ingest endpoint ──────────────────────────────────────────────────
# Where punches are delivered. The public HR ingest route is device-credential
# gated (X-Device-Id / X-Device-Key set per device in the gateway), so this is
# the normal public HTTPS URL through Traefik. Traefik strips /hrm, so the
# container path /device/attendance/logs is reached publicly at
# /hrm/device/attendance/logs.
HR_INGEST_URL=https://your-erp-domain.com/hrm/device/attendance/logs
HR_TIMEOUT_SECONDS=30
# Allow a self-signed HR TLS cert (LAN/testing only — leave false in production).
HR_INSECURE_TLS=false

# ── Credential encryption at rest ───────────────────────────────────────────
# Encrypts each device's HR X-Device-Key in the database (AES-256-GCM), so a
# read-only browse (e.g. phpMyAdmin's erp_ro) never exposes a usable key.
# Generate with: openssl rand -base64 32
CRED_ENC_KEY=CHANGEME_generate_a_32_byte_random_key

# ── Management API auth ─────────────────────────────────────────────────────
# Shared token for the operator/management API (sent as X-API-Key or
# Authorization: Bearer). If empty, the API is OPEN on the LAN — set it.
# Generate with: openssl rand -hex 24
MGMT_API_KEY=CHANGEME_management_api_token

# ── Forwarder (delivery) tuning ─────────────────────────────────────────────
FORWARD_INTERVAL_SECONDS=15
FORWARD_BATCH=200
# 0 = retry undelivered punches forever (recommended: never drop attendance).
# Set >0 to park a punch as Failed after that many attempts for manual review.
FORWARD_MAX_ATTEMPTS=0

# ── Pull collector (poll devices over TCP 4370) ─────────────────────────────
PULL_ENABLED=true
PULL_INTERVAL_SECONDS=30
PULL_CONN_TIMEOUT_SECONDS=10

# ── Push (ADMS/iclock) endpoints ────────────────────────────────────────────
PUSH_ENABLED=true
# Auto-create a device row the first time an unknown serial pushes. It arrives
# with no HR credential, so its punches are held Pending until you set one.
PUSH_AUTO_REGISTER_SN=true

# ── Retention ───────────────────────────────────────────────────────────────
# Purge DELIVERED punches older than this (Pending/Failed are never purged).
# 0 = keep forever. 90 days:
PUNCH_RETENTION_SECONDS=7776000
