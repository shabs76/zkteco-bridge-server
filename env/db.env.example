# MariaDB config. Copy to db.env. Never commit db.env.
#
# Only read on FIRST start, when the data directory is empty. Changing a password
# here later has no effect — rotate with ALTER USER inside the DB.

MARIADB_ROOT_PASSWORD=CHANGEME_root_password

# The gateway's own database user (full rights on erp_zkbio only). Must match
# MYSQL_PASS in env/zkbio.env.
ERP_ZKBIO_DB_PASSWORD=CHANGEME_zkbio_db_password

# Read-only account for phpMyAdmin browsing. SELECT-only — cannot alter data or
# read a device's (encrypted) HR key in a usable form.
ERP_READONLY_DB_PASSWORD=CHANGEME_readonly_password
