# phpMyAdmin config. Copy to phpmyadmin.env. Never commit phpmyadmin.env.
#
# phpMyAdmin is published on the LAN so staff can view attendance data in a
# browser. It presents a login screen; sign in with a database account.

PMA_HOST=mariadb
PMA_PORT=3306

# Leave PMA_USER/PMA_PASSWORD unset so the login screen prompts for credentials
# rather than auto-logging everyone in. For day-to-day viewing, log in as the
# read-only account:  user  erp_ro   password = ERP_READONLY_DB_PASSWORD.
# Use erp_zkbio or root only when a change is genuinely needed.
# PMA_USER=
# PMA_PASSWORD=

PMA_ARBITRARY=0
UPLOAD_LIMIT=64M
MAX_EXECUTION_TIME=600

# Encrypts the phpMyAdmin session cookie. 32 chars.
# Generate with: openssl rand -base64 24
BLOWFISH_SECRET=CHANGEME_32_char_blowfish_secret
