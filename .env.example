# Compose-level configuration. Copy to .env and adjust.
# These control ports, image tuning and the gateway timezone — NOT service
# secrets, which live in env/*.env.

# Timezone the gateway (and MariaDB container) run in. The gateway interprets
# naive device timestamps in this zone. Use your site's zone.
TZ=Africa/Dar_es_Salaam

# LAN exposure. BIND_ADDR=0.0.0.0 publishes on every interface (reachable at the
# Pi's LAN IP). To restrict to one interface, set the Pi's LAN IP here.
BIND_ADDR=0.0.0.0

# Gateway port: serves BOTH the management API and the device /iclock push
# endpoints. Point your ZKTeco devices' ADMS/cloud server at http://<pi-ip>:8080.
ZKBIO_PORT=8080

# Management console (Angular UI) port — open it at http://<pi-ip>:8082
WEBUI_PORT=8082

# phpMyAdmin port — browse the data at http://<pi-ip>:8081
PHPMYADMIN_PORT=8081

# MariaDB InnoDB buffer pool. 256M is comfortable on a 4 GB Pi.
INNODB_BUFFER_POOL_SIZE=256M
