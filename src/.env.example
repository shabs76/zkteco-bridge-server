# Standalone .env for running the gateway directly (go run main.go), outside
# Docker. Copy to src/.env. Inside Docker, env/zkbio.env is used instead.

APP_ENV=development
PORT=8080
LOG_DIR=logs
TZ=Africa/Dar_es_Salaam

# Point at a MariaDB you can reach from the host.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DBNAME=erp_zkbio
MYSQL_USER=erp_zkbio
MYSQL_PASS=change_me

HR_INGEST_URL=https://your-erp-domain.com/hrm/device/attendance/logs
HR_TIMEOUT_SECONDS=30
HR_INSECURE_TLS=false

CRED_ENC_KEY=dev_only_change_me_32_bytes_please
MGMT_API_KEY=dev_management_token

FORWARD_INTERVAL_SECONDS=15
FORWARD_BATCH=200
FORWARD_MAX_ATTEMPTS=0

PULL_ENABLED=true
PULL_INTERVAL_SECONDS=30
PULL_CONN_TIMEOUT_SECONDS=10

PUSH_ENABLED=true
PUSH_AUTO_REGISTER_SN=true

# ── Employee (device user) name sync ────────────────────────────────────────
# The gateway keeps a local registry of device users so operators can see WHO a
# punch belongs to. Names are NOT forwarded to HR (its ingest contract carries
# employeeNumber only) — they are for the console, exports and reconciliation.
# Pull devices are read on this slower cadence; push devices send their user
# table to /iclock/cdata on their own schedule. 3600 = hourly.
EMPLOYEE_SYNC_ENABLED=true
EMPLOYEE_SYNC_INTERVAL_SECONDS=3600

PUNCH_RETENTION_SECONDS=7776000
